# ============ Etkinlik Hatira — Ortam Degiskenleri ============
# Bu dosyayi .env olarak kopyalayip doldurun.
# cp .env.example .env

# ---------- Etkinlik ----------
EVENT_TYPE=wedding
# Desteklenen tipler: wedding, engagement, henna, circumcision,
#   birthday, graduation, boat, group, corporate, festival

EVENT_NAME="Sinem & Mete Can"
EVENT_DATE=2026-06-15
TOTAL_ZONES=40
SEATS_PER_ZONE=10
MAX_UPLOADS=5

# ---------- Admin ----------
ADMIN_PASS=guclu-sifre-buraya

# ---------- Branding ----------
# PRIMARY_COLOR=#d4a853
# SECONDARY_COLOR=#1a1a2e
# LOGO_URL=https://example.com/logo.png
# WELCOME_MESSAGE="Ozel mesajiniz burada"

# ---------- Storage ----------
STORAGE_TYPE=local
# STORAGE_TYPE=r2 olunca asagidakileri doldur:
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=event-uploads
# R2_PUBLIC_URL=https://cdn.yourdomain.com

# ---------- Server ----------
PORT=3000
# NODE_ENV=production
